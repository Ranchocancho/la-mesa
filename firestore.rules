rules_version = '2';

// Reglas de seguridad de La Mesa.
// Cada documento de "campaigns" es un MUNDO.
// - Solo los miembros de un mundo ven sus datos.
// - Lo modifican su dueño (el administrador, quien lo creó) y los másteres que él nombre.
// - Solo el dueño nombra o quita másteres.
// - Los jugadores solo reciben los lugares visibles y el contenido revelado.
// - Las notas secretas solo las leen el dueño y los másteres.
// - Cualquiera con el enlace y una cuenta de Google puede unirse como jugador.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function world(c) { return get(/databases/$(database)/documents/campaigns/$(c)).data; }
    function isMember(c) { return signedIn() && request.auth.uid in world(c).memberIds; }
    function editorOf(w) { return signedIn() && (w.owner == request.auth.uid || request.auth.uid in w.get('dms', [])); }
    function isEditor(c) { return editorOf(world(c)); }

    // Un jugador se añade a sí mismo, sin tocar nada más.
    function joiningSelf() {
      let before = resource.data;
      let after = request.resource.data;
      return after.diff(before).affectedKeys().hasOnly(['memberIds', 'members'])
        && after.memberIds.toSet().difference(before.memberIds.toSet()) == [request.auth.uid].toSet()
        && before.memberIds.toSet().difference(after.memberIds.toSet()).size() == 0
        && after.members.diff(before.members).affectedKeys().hasOnly([request.auth.uid])
        && after.members[request.auth.uid].role == 'player';
    }

    match /campaigns/{c} {
      allow get: if signedIn();
      allow list: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid];
      allow update: if signedIn() && (
        (editorOf(resource.data)
          && request.resource.data.owner == resource.data.owner
          && (resource.data.owner == request.auth.uid
              || request.resource.data.get('dms', []) == resource.data.get('dms', [])))
        || joiningSelf());
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      match /places/{p} {
        allow read: if isEditor(c) || (isMember(c) && resource.data.visible == true);
        allow write: if isEditor(c);
      }
      match /items/{i} {
        allow read: if isEditor(c) || (isMember(c) && resource.data.revealed == true);
        allow write: if isEditor(c);
      }
      // Fichas: todo el grupo las ve; cada jugador crea y edita la suya; el administrador y los másteres, todas.
      match /characters/{ch} {
        allow read: if isMember(c);
        allow create: if isEditor(c) || (isMember(c) && request.resource.data.owner == request.auth.uid);
        allow update: if isEditor(c) || (isMember(c) && resource.data.owner == request.auth.uid
          && request.resource.data.owner == request.auth.uid);
        allow delete: if isEditor(c) || (isMember(c) && resource.data.owner == request.auth.uid);
      }
      // Mesa táctica: escenas preparadas (solo máster), la mesa en directo y las fichas sobre ella.
      match /scenes/{sc} {
        allow read, write: if isEditor(c);
      }
      match /board/{b} {
        allow read: if isMember(c);
        allow write: if isEditor(c);
        // Cualquier jugador puede terminar el turno (pasar al siguiente), sin tocar nada más de la mesa
        allow update: if isMember(c) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['turn', 'round', 'seq', 'starts', 'from']);
      }
      match /tokens/{t} {
        allow read: if isMember(c);
        allow create, delete: if isEditor(c);
        allow update: if isEditor(c) || (isMember(c) && resource.data.owner == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['c', 'r', 'init', 'conds', 'fx', 'eco']));
      }
      // Crónica: todos la leen; cada uno escribe y corrige sus notas; el máster puede corregir todas.
      match /chronicle/{e} {
        allow read: if isMember(c);
        allow create: if isMember(c) && request.resource.data.by == request.auth.uid;
        allow update, delete: if isEditor(c) || (isMember(c) && resource.data.by == request.auth.uid);
      }
      // Tiradas: todos las ven; cada uno publica las suyas; el máster las confirma, cambia o anula.
      match /rolls/{r} {
        allow read: if isMember(c);
        allow create: if isMember(c) && request.resource.data.who == request.auth.uid;
        allow update: if isEditor(c);
        allow delete: if isEditor(c) || (isMember(c) && resource.data.who == request.auth.uid);
      }
      // Lore: el máster lo crea todo; los jugadores solo leen lo que se les ha revelado.
      match /lore/{l} {
        allow read: if isEditor(c) || (isMember(c) && resource.data.revealed == true);
        allow write: if isEditor(c);
      }
      match /secrets/{s} {
        allow read, write: if isEditor(c);
      }
      // Imágenes: los jugadores también suben (por ejemplo, el retrato de su personaje).
      match /images/{k} {
        allow read: if isMember(c);
        allow write: if isMember(c);
        match /c/{n} {
          allow read: if isMember(c);
          allow write: if isMember(c);
        }
      }
      match /presence/{u} {
        allow read: if isMember(c);
        allow write: if isMember(c) && u == request.auth.uid;
      }
    }
  }
}
